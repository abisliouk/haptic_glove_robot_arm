# ROS-specific ignore rules
devel/
logs/
build/
bin/
lib/
msg_gen/
srv_gen/
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
build_isolated/
devel_isolated/

# Generated by dynamic reconfigure
*.cfgc
/cfg/cpp/
/cfg/*.py

# Ignore generated docs
*.dox
*.wikidoc

# Eclipse IDE files
.project
.cproject

# Qt Creator files
CMakeLists.txt.user
qtcreator-*
*.user

# ROS service files
srv/_*.py
*.pcd

# Ignore Python compiled files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
*.eggs/
*.whl
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
/.venv
/.env

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore temporary files
*~
*.swp
*.swo
*.bak

# Emacs
.#*

# Catkin custom files
CATKIN_IGNORE
